{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "popupcalc",
  "version": "0.1.0",
  "identifier": "de.maxpoer.popupcalc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PopUpCalc",
        "width": 1000,
        "height": 90,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
